{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UseSwagger": true,
  "OSDatabase": "Host=localhost; Database=OS; Port=5432; Username=postgres; Password=postgres",


  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "localhost",
    "Audience": "localhost",
    "SecretKey": "secret_key",
    "TokenValidityInMinutes": 60,
    "RefreshTokenValidityInDays": 1,
    "SecurityAlgorithms": "HS256"
  },
  "Passwords": {
    "Admin_Password": "Password",
    "User_Password": "Password"
  },
  "BASE_URL": "https://localhost",
  "MediaPaths": {
    "MEDIA_ROOT": "static",
    "PARTNER_ROOT": "partners",
    "PRODUCT_ROOT": "products",
    "USER_ROOT": "users"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:5200"
      }
    }
  }
}
  