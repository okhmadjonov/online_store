## Visual Studio / .NET standard .gitignore

# Build results & output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/

# Visual Studio files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userlibraries
*.cache

# JetBrains Rider / VS Code
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sln.iml

# User-specific files & local settings
*.rsuser
appsettings.*.local.json
appsettings.Secrets.json
secrets.json

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
